# Every variable is MCP_<SECTION>_<FIELD>, where SECTION is a config.json section:
# MCP_SERVER_*, MCP_FASTMCP_*, MCP_DATABASE_*, MCP_AUTH_*. A variable without the section
# prefix (for example MCP_PORT or plain DATABASE) is ignored.

# =============================================================================
# SERVER CONFIGURATION (postgres_fastmcp.app.config.server.ServerSettings)
# =============================================================================
# Host to bind the server to: 127.0.0.1 by default; the Docker image sets 0.0.0.0 itself,
# so leave this commented out for --env-file, or the container is unreachable from outside
# MCP_SERVER_HOST=127.0.0.1

# Port to bind the server to
MCP_SERVER_PORT=8000

# Global transport: 'http' or 'stdio'
MCP_SERVER_TRANSPORT=http

# Path of the MCP endpoint (a leading slash is added if missing)
MCP_SERVER_ENDPOINT=/mcp

# Health check endpoint GET /health, served without authentication: 200 when the database
# answers SELECT 1 within 2 seconds, otherwise 503 with a generic error; details go to the server log
MCP_SERVER_HEALTH_ENDPOINT_ENABLED=true

# Max tool response size in tokens (bytes of text / 3); a larger response is replaced by a
# "refine the request" error. Minimum 1000.
MCP_SERVER_RESPONSE_MAX_TOKENS=20000


# =============================================================================
# FASTMCP CONFIGURATION (postgres_fastmcp.app.config.fastmcp.FastMCPSettings)
# =============================================================================
# MCP server name
MCP_FASTMCP_SERVER_NAME=postgres-fastmcp

# Instructions for LLM clients (server purpose description)
# MCP_FASTMCP_INSTRUCTIONS=...


# =============================================================================
# DATABASE CONFIGURATION (postgres_fastmcp.app.config.database.DatabaseSettings)
# =============================================================================
# Одна БД на сервер. Свой префикс MCP_DATABASE_ (без вложенного __). URI собирается из компонентов.
#
# Обязательные (все нужны для подключения):
# MCP_DATABASE_HOST=localhost
# MCP_DATABASE_PORT=5432
# MCP_DATABASE_USER=user
# MCP_DATABASE_PASSWORD=password
# MCP_DATABASE_NAME=dbname
#
# Опциональные (значения по умолчанию):
# MCP_DATABASE_SSLMODE=
#   Режим SSL: disable, allow, prefer, require, verify-ca, verify-full. Не задавать — не передавать в URI.
# MCP_DATABASE_CLIENT_ENCODING=UTF8
#   Кодировка клиента в query string URI.
# MCP_DATABASE_CONNECT_OPTIONS={}
#   Параметры libpq (JSON-объект строк) в query string URI: {"target_session_attrs": "read-write", "connect_timeout": "5"}.
#   host, hostaddr, port, user, password, dbname, sslmode, ssl, requiressl, client_encoding (свои поля) и
#   sslpassword, passfile, oauth_client_secret, sslkeylogfile (секреты; URI может попасть в логи и сообщения об ошибках) — запрещены.
#   Параметр, неизвестный libpq, — ошибка при загрузке конфигурации.
# MCP_DATABASE_POOL_MIN_SIZE=1
# MCP_DATABASE_POOL_MAX_SIZE=10
# MCP_DATABASE_MAX_INACTIVE_CONNECTION_LIFETIME=300
#   Секунды простоя, после которых пул закрывает соединение сверх POOL_MIN_SIZE.
# MCP_DATABASE_WRITE_MODE=false
#   false = только чтение (SELECT), true = разрешён DML/DDL при access_mode=full.
# MCP_DATABASE_ACCESS_MODE=basic
#   access_mode: basic = только схема public, 4 инструмента; full = все схемы, 9 инструментов.
# MCP_DATABASE_SAFE_SQL_TIMEOUT=30
# MCP_DATABASE_TABLE_PREFIX=
#   Для access_mode=basic: только объекты с именами, начинающимися с этого префикса. Для full игнорируется.
# MCP_DATABASE_PLAN_CHECK=false
#   Для access_mode=basic: проверять план запроса агента (EXPLAIN VERBOSE) и отклонять чтение вне public через представления и функции.
# MCP_DATABASE_QUERY_TAG=
#   Тег для SafeSqlDriver (например имя сервера).
#
# Пример:
# MCP_DATABASE_HOST=localhost
# MCP_DATABASE_PORT=5432
# MCP_DATABASE_USER=appuser
# MCP_DATABASE_PASSWORD=secret
# MCP_DATABASE_NAME=production
# MCP_DATABASE_ACCESS_MODE=full
# MCP_DATABASE_WRITE_MODE=false
# MCP_DATABASE_SSLMODE=disable


# =============================================================================
# AUTH CONFIGURATION (postgres_fastmcp.app.config.auth.AuthSettings)
# =============================================================================
# HTTP authentication; stdio ignores it. Nested fields use "__", lists and dicts are JSON strings.
# JSON values are written unquoted: docker --env-file keeps quotes literally, and .env reads them as is.
# In a shell, wrap the value in single quotes: export MCP_AUTH_REQUIRED_SCOPES='["mcp"]'.
# Mode: none | static | jwt | oidc
MCP_AUTH_MODE=none

# Scopes every token must carry (all modes except none)
# MCP_AUTH_REQUIRED_SCOPES=["mcp"]

# static: token string -> {client_id, scopes?, claims?}; or a JSON file of the same shape
# MCP_AUTH_TOKENS={"<long random string>":{"client_id":"ci-bot","scopes":["pg:write"]}}
# MCP_AUTH_TOKENS_FILE=/run/secrets/mcp-tokens.json

# jwt: exactly one of JWKS URI and public key (or HS shared secret with MCP_AUTH_JWT_ALGORITHM=HS256)
# MCP_AUTH_JWT_JWKS_URI=https://sso.example.com/realms/main/protocol/openid-connect/certs
# MCP_AUTH_JWT_PUBLIC_KEY=
# MCP_AUTH_JWT_ISSUER=https://sso.example.com/realms/main
# MCP_AUTH_JWT_AUDIENCE=postgres-fastmcp
# MCP_AUTH_JWT_ALGORITHM=RS256

# oidc: OAuth proxy to the corporate IdP
# MCP_AUTH_OIDC_CONFIG_URL=https://sso.example.com/realms/main/.well-known/openid-configuration
# MCP_AUTH_OIDC_CLIENT_ID=postgres-fastmcp
# MCP_AUTH_OIDC_CLIENT_SECRET=
# MCP_AUTH_OIDC_AUDIENCE=
# MCP_AUTH_BASE_URL=https://mcp.example.com

# Narrow each request below the database ceiling by a token claim
# MCP_AUTH_ACCESS_POLICY__ENFORCED=false
# MCP_AUTH_ACCESS_POLICY__CLAIM=scope
# MCP_AUTH_ACCESS_POLICY__WRITE_VALUES=["pg:write"]
# MCP_AUTH_ACCESS_POLICY__FULL_VALUES=["pg:full"]


# =============================================================================
# DOCKER (Makefile / CI)
# =============================================================================
# Docker image repository (full path without tag)
# Example: repo.example.com/team/postgres-fastmcp
DOCKER_IMAGE=postgres-fastmcp

# Docker image tag
DOCKER_TAG=latest

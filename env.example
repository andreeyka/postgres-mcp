# =============================================================================
# SERVER CONFIGURATION (postgres_fastmcp.app.config.server.ServerSettings)
# =============================================================================
# Host to bind the server to (use 0.0.0.0 for containers, 127.0.0.1 for local)
MCP_SERVER_HOST=127.0.0.1

# Port to bind the server to
MCP_SERVER_PORT=8000

# Global transport: 'http' or 'stdio'
MCP_SERVER_TRANSPORT=http

# Default endpoint path
MCP_SERVER_ENDPOINT=mcp

# Number of workers
MCP_SERVER_WORKERS=1

# Enable health check endpoint at /health (no auth required)
MCP_SERVER_HEALTH_ENDPOINT_ENABLED=true


# =============================================================================
# FASTMCP CONFIGURATION (postgres_fastmcp.app.config.fastmcp.FastMCPSettings)
# =============================================================================
# MCP server name
MCP_FASTMCP_SERVER_NAME=postgres-fastmcp

# Instructions for LLM clients (server purpose description)
# MCP_FASTMCP_INSTRUCTIONS=...

# Return errors as strings in LLM responses instead of standard MCP errors
MCP_FASTMCP_RETURN_ERRORS_AS_STRINGS=true

# Include traceback in error strings when return_errors_as_strings=true
MCP_FASTMCP_ERROR_TRACEBACK_IN_STRINGS=false


# =============================================================================
# DATABASE CONFIGURATION (postgres_fastmcp.app.config.database.DatabaseConfig)
# =============================================================================
# Одна БД на сервер. Свой префикс MCP_DATABASE_ (без вложенного __). URI собирается из компонентов.
#
# Обязательные (все нужны для подключения):
# MCP_DATABASE_HOST=localhost
# MCP_DATABASE_PORT=5432
# MCP_DATABASE_USER=user
# MCP_DATABASE_PASSWORD=password
# MCP_DATABASE_NAME=dbname
#
# Опциональные (значения по умолчанию):
# MCP_DATABASE_SSLMODE=
#   Режим SSL: disable, allow, prefer, require, verify-ca, verify-full. Не задавать — не передавать в URI.
# MCP_DATABASE_CLIENT_ENCODING=UTF8
#   Кодировка клиента в query string URI.
# MCP_DATABASE_POOL_MIN_SIZE=1
# MCP_DATABASE_POOL_MAX_SIZE=10
# MCP_DATABASE_MAX_INACTIVE_CONNECTION_LIFETIME=300
# MCP_DATABASE_WRITE_MODE=false
#   false = только чтение (SELECT), true = разрешён DML/DDL при access_mode=full.
# MCP_DATABASE_ACCESS_MODE=basic
#   access_mode: basic = только схема public, 4 инструмента; full = все схемы, 9 инструментов.
# MCP_DATABASE_SAFE_SQL_TIMEOUT=30
# MCP_DATABASE_TABLE_PREFIX=
#   Для access_mode=basic: только объекты с именами, начинающимися с этого префикса. Для full игнорируется.
# MCP_DATABASE_QUERY_TAG=
#   Тег для SafeSqlDriver (например имя сервера).
#
# Пример:
# MCP_DATABASE_HOST=localhost
# MCP_DATABASE_PORT=5432
# MCP_DATABASE_USER=appuser
# MCP_DATABASE_PASSWORD=secret
# MCP_DATABASE_NAME=production
# MCP_DATABASE_ACCESS_MODE=full
# MCP_DATABASE_WRITE_MODE=false
# MCP_DATABASE_SSLMODE=disable


# =============================================================================
# DOCKER (Makefile / CI)
# =============================================================================
# Docker image repository (full path without tag)
# Example: repo.example.com/team/postgres-fastmcp
DOCKER_IMAGE=postgres-fastmcp

# Docker image tag
DOCKER_TAG=latest
